algoritmo "Exercício 4 — Dobro e Metade"
var
  n1, n2: inteiro
  dobro: inteiro
  metade: real
inicio

    escreva("Escreva o primeiro numero: ")
    leia(n1)
    
    dobro:=  n1 + 2
    metade:= n1 * 2
    
    escreva("O dobro é:", dobro)
    
    escreval
    escreval("A metade é:",metade)
fimalgoritmo
