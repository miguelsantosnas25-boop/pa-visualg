algoritmo "Exercício 6 — Área de um Terreno"
var
  Largura, comprimento, area: real
inicio
    escreva("Digite a largura: ")
    Leia(largura)
    
    escreva("Digite o comprimento: ")
    Leia(comprimento)

     area <- largura * comprimento
     
     escreva("A Àrea do terreno é:",area, " metros ao quadrado")






fimalgoritmo
